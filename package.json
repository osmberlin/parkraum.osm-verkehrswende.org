{
  "name": "parkraum-osm-verkehrswende-org",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run fetchRegions && astro dev",
    "start": "bun run dev",
    "build": "bun run fetchRegions && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fetchRegions": "vite-node ./data/fetchRegions.ts && prettier ./data/regions.json --write",
    "type-check": "astro check && tsc --skipLibCheck --noEmit",
    "lint": "oxlint --fix --disable-typescript-plugin src",
    "format": "prettier --ignore-path .gitignore '{src,data}/**/*.+(ts|js|tsx|astro|mdx)' --write",
    "check": "bun run type-check && bun run format && bun run lint",
    "updatePackages:major": "bunx taze major --write && bun install",
    "updatePackages:minor": "bunx taze minor --write && bun install",
    "prepare": "husky"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.15.12",
    "@astrojs/alpinejs": "^0.5.0",
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/ts-plugin": "^1.10.7",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.8",
    "@turf/turf": "^7.3.5",
    "@types/alpinejs": "^3.13.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "alpinejs": "^3.15.12",
    "astro": "^6.2.1",
    "clsx": "^2.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remark-toc": "^9.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite-node": "^6.0.0"
  },
  "devDependencies": {
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "husky": "^9.1.7",
    "oxlint": "1.62.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-astro-organize-imports": "^0.4.12",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
