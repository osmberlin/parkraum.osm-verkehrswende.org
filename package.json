{
  "name": "parkraum-osm-verkehrswende-org",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=26 <27",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run fetchRegions && astro dev",
    "start": "bun run dev",
    "build": "bun run fetchRegions && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fetchRegions": "vite-node ./data/fetchRegions.ts && prettier ./data/regions.json --write",
    "type-check": "astro check && tsc --skipLibCheck --noEmit",
    "lint": "oxlint --fix src",
    "format": "prettier --ignore-path .gitignore '{src,data}/**/*.+(ts|js|tsx|astro|mdx)' --write",
    "check": "bun run type-check && bun run format && bun run lint",
    "updatePackages:major": "bunx taze major --includeLocked --maturity-period 5 --write && bun install",
    "updatePackages:minor": "bunx taze minor --includeLocked --maturity-period 5 --write && bun install",
    "prepare": "husky"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.17.5",
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/ts-plugin": "^1.10.12",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.2",
    "@turf/turf": "^7.4.0",
    "@types/alpinejs": "^3.17.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "alpinejs": "^3.17.5",
    "astro": "^7.4.5",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-toc": "^9.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite-node": "^6.0.0"
  },
  "devDependencies": {
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "husky": "^9.1.7",
    "oxc-transform-react": "^0.156.0",
    "oxlint": "1.90.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-astro-organize-imports": "^0.4.14",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "trustedDependencies": [
    "@astrojs/language-server"
  ]
}
